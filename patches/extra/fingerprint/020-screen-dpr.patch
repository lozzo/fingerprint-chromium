+gfx::Size GetFingerprintScreenSize() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  int width = 1920;
+  int height = 1080;
+  if (command_line->HasSwitch(::switches::kFingerprintScreenWidth)) {
+    width = std::stoi(
+        command_line->GetSwitchValueASCII(::switches::kFingerprintScreenWidth));
+  }
+  if (command_line->HasSwitch(::switches::kFingerprintScreenHeight)) {
+    height = std::stoi(
+        command_line->GetSwitchValueASCII(::switches::kFingerprintScreenHeight));
+  }
+  return gfx::Size(width, height);
+}

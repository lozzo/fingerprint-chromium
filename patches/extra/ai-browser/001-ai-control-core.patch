+#ifndef CHROME_BROWSER_AI_CONTROL_AI_CONTROL_SERVICE_H_
+#define CHROME_BROWSER_AI_CONTROL_AI_CONTROL_SERVICE_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+
+namespace base {
+class CommandLine;
+class SingleThreadTaskRunner;
+}  // namespace base
+
+namespace ai_control {
+
+class AiControlService {
+ public:
+  static std::unique_ptr<AiControlService> CreateFromCommandLine(
+      const base::CommandLine& command_line,
+      scoped_refptr<base::SingleThreadTaskRunner> io_task_runner);
+  static AiControlService* Get();
+
+  AiControlService(const AiControlService&) = delete;
+  AiControlService& operator=(const AiControlService&) = delete;
+  ~AiControlService();
+
+ private:
+  class IOThreadData;
+
+  AiControlService(scoped_refptr<base::SingleThreadTaskRunner> io_task_runner,
+                   int port,
+                   base::FilePath info_file,
+                   std::string token,
+                   std::string browser_instance_id);
+
+  void OnServerCreated(int port);
+  void OnWebSocketAccepted(int connection_id);
+  void OnWebSocketMessage(int connection_id, std::string message);
+  void OnWebSocketClosed(int connection_id);
+  void SendMessage(int connection_id, base::DictValue message);
+  base::DictValue HandleCommand(const base::DictValue& request);
+  base::ListValue BuildTabsSnapshot();
+
+  const scoped_refptr<base::SingleThreadTaskRunner> io_task_runner_;
+  const base::FilePath info_file_;
+  const std::string token_;
+  const std::string browser_instance_id_;
+  std::optional<int> active_connection_id_;
+  std::unique_ptr<IOThreadData> io_thread_data_;
+
+  base::WeakPtrFactory<AiControlService> weak_ptr_factory_{this};
+};
+
+}  // namespace ai_control

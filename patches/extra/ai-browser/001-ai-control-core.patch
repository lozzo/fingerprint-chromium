+namespace ai_control {
+namespace {
+
+constexpr char kPortSwitch[] = "ai-control-port";
+constexpr char kInfoFileSwitch[] = "ai-control-info-file";
+constexpr char kWebSocketPath[] = "/ai-control/v1";
+constexpr size_t kMaxMessageSize = 64 * 1024;
+constexpr int kBacklog = 8;
+
+AiControlService* g_ai_control_service = nullptr;
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("ai_browser_control", R"(
+      semantics {
+        sender: "AI Browser Control"
+        description:
+          "A command line enabled loopback WebSocket used by a local AI "
+          "controller to coordinate browser tab UI and ownership."
+        trigger: "The browser is launched with --ai-control-port."
+        data: "Tab metadata and local browser control commands."
+        destination: LOCAL
+      }
+      policy {
+        cookies_allowed: NO
+        setting:
+          "Disabled unless explicitly enabled by a command line switch."
+        policy_exception_justification: "Not implemented."
+      })");
+
+base::DictValue MakeError(std::string_view code, std::string_view message) {
+  base::DictValue error;
+  error.Set("code", code);
+  error.Set("message", message);
+  return error;
+}
+
+void WriteInfoFile(const base::FilePath& path,
+                   int port,
+                   std::string token,
+                   std::string browser_instance_id) {
+  if (base::IsLink(path)) {
+    LOG(ERROR) << "AI control info file cannot be a symbolic link";
+    return;
+  }
+
+  base::DictValue info;
+  info.Set("protocolVersion", 1);
+  info.Set("port", port);
+  info.Set("pid", static_cast<int>(base::GetCurrentProcId()));
+  info.Set("browserInstanceId", std::move(browser_instance_id));
+  info.Set("token", std::move(token));
+  std::string json;
+  if (!base::JSONWriter::Write(info, &json) ||
+      !base::ImportantFileWriter::WriteFileAtomically(path, json)) {
+    LOG(ERROR) << "Failed to write AI control info file";
+    return;
+  }
+#if BUILDFLAG(IS_POSIX)
+  if (!base::SetPosixFilePermissions(
+          path, base::FILE_PERMISSION_READ_BY_USER |
+                    base::FILE_PERMISSION_WRITE_BY_USER)) {
+    LOG(ERROR) << "Failed to restrict AI control info file permissions";
+  }
+#endif
+}
+
+}  // namespace
+
+class AiControlService::IOThreadData : public net::HttpServer::Delegate {
+ public:
+  IOThreadData(base::WeakPtr<AiControlService> owner,
+               std::string token,
+               scoped_refptr<base::SingleThreadTaskRunner> ui_task_runner)
+      : owner_(std::move(owner)),
+        token_(std::move(token)),
+        ui_task_runner_(std::move(ui_task_runner)) {
+    DETACH_FROM_SEQUENCE(io_sequence_checker_);
+  }
+
+  IOThreadData(const IOThreadData&) = delete;
+  IOThreadData& operator=(const IOThreadData&) = delete;
+  ~IOThreadData() override = default;
+
+  void Start(int port) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(io_sequence_checker_);
+    auto socket =
+        std::make_unique<net::TCPServerSocket>(nullptr, net::NetLogSource());
+    int result = socket->Listen(
+        net::IPEndPoint(net::IPAddress::IPv4Localhost(), port), kBacklog,
+        /*ipv6_only=*/std::nullopt);
+    if (result != net::OK) {
+      ui_task_runner_->PostTask(
+          FROM_HERE,
+          base::BindOnce(&AiControlService::OnServerCreated, owner_, -1));
+      return;
+    }
+
+    server_ = std::make_unique<net::HttpServer>(std::move(socket), this);
+    net::IPEndPoint local_address;
+    result = server_->GetLocalAddress(&local_address);
+    port_ = result == net::OK ? local_address.port() : -1;
+    ui_task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&AiControlService::OnServerCreated, owner_, port_));
+  }
+
+  void Send(int connection_id, std::string message) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(io_sequence_checker_);
+    if (server_ && active_connection_id_ == connection_id) {
+      server_->SendOverWebSocket(connection_id, message, kTrafficAnnotation);
+    }
+  }
+
+ private:
+  void OnConnect(int connection_id) override {}
+
+  void OnHttpRequest(int connection_id,
+                     const net::HttpServerRequestInfo& info) override {
+    server_->Send404(connection_id, kTrafficAnnotation);
+  }
+
+  void OnWebSocketRequest(
+      int connection_id,
+      const net::HttpServerRequestInfo& info) override {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(io_sequence_checker_);
+    const std::string expected_authorization = "Bearer " + token_;
+    const std::string authorization = info.GetHeaderValue("authorization");
+    const std::string expected_host =
+        base::StringPrintf("127.0.0.1:%d", port_);
+    const bool authenticated =
+        authorization.size() == expected_authorization.size() &&
+        crypto::SecureMemEqual(base::as_byte_span(authorization),
+                               base::as_byte_span(expected_authorization));
+    const bool valid =
+        info.method == "GET" && info.path == kWebSocketPath &&
+        info.GetHeaderValue("host") == expected_host &&
+        !info.headers.contains("origin") &&
+        !info.headers.contains("sec-websocket-extensions") &&
+        !info.headers.contains("sec-websocket-protocol") && authenticated;
+    if (!valid) {
+      server_->Send(connection_id, net::HTTP_FORBIDDEN, "Forbidden",
+                    "text/plain", kTrafficAnnotation);
+      return;
+    }
+
+    if (active_connection_id_.has_value() &&
+        *active_connection_id_ != connection_id) {
+      server_->Close(*active_connection_id_);
+    }
+    active_connection_id_ = connection_id;
+    server_->AcceptWebSocket(connection_id, info, kTrafficAnnotation);
+    ui_task_runner_->PostTask(
+        FROM_HERE, base::BindOnce(&AiControlService::OnWebSocketAccepted,
+                                  owner_, connection_id));
+  }
+
+  void OnWebSocketMessage(int connection_id, std::string data) override {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(io_sequence_checker_);
+    if (active_connection_id_ != connection_id) {
+      return;
+    }
+    if (data.size() > kMaxMessageSize) {
+      server_->Close(connection_id);
+      return;
+    }
+    ui_task_runner_->PostTask(
+        FROM_HERE, base::BindOnce(&AiControlService::OnWebSocketMessage,
+                                  owner_, connection_id, std::move(data)));
+  }
+
+  void OnClose(int connection_id) override {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(io_sequence_checker_);
+    if (active_connection_id_ != connection_id) {
+      return;
+    }
+    active_connection_id_.reset();
+    ui_task_runner_->PostTask(
+        FROM_HERE, base::BindOnce(&AiControlService::OnWebSocketClosed, owner_,
+                                  connection_id));
+  }
+
+  base::WeakPtr<AiControlService> owner_;
+  const std::string token_;
+  const scoped_refptr<base::SingleThreadTaskRunner> ui_task_runner_;
+  std::unique_ptr<net::HttpServer> server_;
+  std::optional<int> active_connection_id_;
+  int port_ = -1;
+  SEQUENCE_CHECKER(io_sequence_checker_);
+};
+
+std::unique_ptr<AiControlService> AiControlService::CreateFromCommandLine(
+    const base::CommandLine& command_line,
+    scoped_refptr<base::SingleThreadTaskRunner> io_task_runner) {
+  if (!command_line.HasSwitch(kPortSwitch)) {
+    return nullptr;
+  }
+
+  int port = -1;
+  if (!base::StringToInt(command_line.GetSwitchValueASCII(kPortSwitch), &port) ||
+      port < 0 || port > 65535) {
+    LOG(ERROR) << "Invalid --ai-control-port value";
+    return nullptr;
+  }
+  base::FilePath info_file = command_line.GetSwitchValuePath(kInfoFileSwitch);
+  if (!info_file.IsAbsolute()) {
+    LOG(ERROR) << "--ai-control-info-file must be an absolute path";
+    return nullptr;
+  }
+
+  return std::unique_ptr<AiControlService>(new AiControlService(
+      std::move(io_task_runner), port, std::move(info_file),
+      base::HexEncode(base::RandBytesAsVector(32)),
+      base::Uuid::GenerateRandomV4().AsLowercaseString()));
+}
+
+AiControlService* AiControlService::Get() {
+  return g_ai_control_service;
+}
+
+AiControlService::AiControlService(
+    scoped_refptr<base::SingleThreadTaskRunner> io_task_runner,
+    int port,
+    base::FilePath info_file,
+    std::string token,
+    std::string browser_instance_id)
+    : io_task_runner_(std::move(io_task_runner)),
+      info_file_(std::move(info_file)),
+      token_(std::move(token)),
+      browser_instance_id_(std::move(browser_instance_id)) {
+  CHECK(!g_ai_control_service);
+  g_ai_control_service = this;
+  io_thread_data_ = std::make_unique<IOThreadData>(
+      weak_ptr_factory_.GetWeakPtr(), token_,
+      base::SingleThreadTaskRunner::GetCurrentDefault());
+  io_task_runner_->PostTask(
+      FROM_HERE, base::BindOnce(&IOThreadData::Start,
+                                base::Unretained(io_thread_data_.get()), port));
+}
+
+AiControlService::~AiControlService() {
+  CHECK_EQ(g_ai_control_service, this);
+  g_ai_control_service = nullptr;
+  weak_ptr_factory_.InvalidateWeakPtrs();
+  io_task_runner_->DeleteSoon(FROM_HERE, std::move(io_thread_data_));
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock()},
+      base::BindOnce(base::IgnoreResult(&base::DeleteFile), info_file_));
+}
+
+void AiControlService::OnServerCreated(int port) {
+  if (port < 0) {
+    LOG(ERROR) << "Failed to start AI control server";
+    return;
+  }
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock()},
+      base::BindOnce(&WriteInfoFile, info_file_, port, token_,
+                     browser_instance_id_));
+}
+
+void AiControlService::OnWebSocketAccepted(int connection_id) {
+  active_connection_id_ = connection_id;
+  base::DictValue ready;
+  ready.Set("eventSeq", 1);
+  ready.Set("method", "Browser.ready");
+  ready.SetByDottedPath("params.protocolVersion", 1);
+  ready.SetByDottedPath("params.browserInstanceId", browser_instance_id_);
+  SendMessage(connection_id, std::move(ready));
+}
+
+void AiControlService::OnWebSocketMessage(int connection_id,
+                                           std::string message) {
+  if (active_connection_id_ != connection_id) {
+    return;
+  }
+  std::optional<base::DictValue> request = base::JSONReader::ReadDict(message, 0);
+  if (!request.has_value()) {
+    base::DictValue response;
+    response.Set("error", MakeError("INVALID_REQUEST", "Expected JSON object"));
+    SendMessage(connection_id, std::move(response));
+    return;
+  }
+  SendMessage(connection_id, HandleCommand(*request));
+}
+
+void AiControlService::OnWebSocketClosed(int connection_id) {
+  if (active_connection_id_ == connection_id) {
+    active_connection_id_.reset();
+  }
+}
+
+void AiControlService::SendMessage(int connection_id, base::DictValue message) {
+  std::string json;
+  if (!base::JSONWriter::Write(message, &json)) {
+    return;
+  }
+  io_task_runner_->PostTask(
+      FROM_HERE, base::BindOnce(&IOThreadData::Send,
+                                base::Unretained(io_thread_data_.get()),
+                                connection_id, std::move(json)));
+}
+
+base::DictValue AiControlService::HandleCommand(
+    const base::DictValue& request) {
+  base::DictValue response;
+  std::optional<int> id = request.FindInt("id");
+  const std::string* method = request.FindString("method");
+  if (id.has_value()) {
+    response.Set("id", *id);
+  }
+  if (!id.has_value() || !method) {
+    response.Set("error",
+                 MakeError("INVALID_REQUEST", "id and method are required"));
+    return response;
+  }
+
+  base::DictValue result;
+  if (*method == "Browser.getVersion") {
+    result.Set("protocolVersion", 1);
+    result.Set("browserInstanceId", browser_instance_id_);
+  } else if (*method == "Browser.getTabs") {
+    result.Set("tabs", BuildTabsSnapshot());
+  } else {
+    response.Set("error", MakeError("METHOD_NOT_FOUND", "Unknown method"));
+    return response;
+  }
+  response.Set("result", std::move(result));
+  return response;
+}
+
+base::ListValue AiControlService::BuildTabsSnapshot() {
+  base::ListValue tabs;
+  for (BrowserWindowInterface* browser : GetAllBrowserWindowInterfaces()) {
+    if (browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+        browser->GetProfile()->IsOffTheRecord()) {
+      continue;
+    }
+    TabStripModel* model = browser->GetTabStripModel();
+    for (int index = 0; index < model->count(); ++index) {
+      tabs::TabInterface* tab = model->GetTabAtIndex(index);
+      content::WebContents* contents = tab->GetContents();
+      if (!contents) {
+        continue;
+      }
+      base::DictValue value;
+      value.Set("tabId",
+                base::StringPrintf("tab-%d", tab->GetHandle().raw_value()));
+      value.Set("pageTargetId",
+                content::DevToolsAgentHost::GetOrCreateFor(contents)->GetId());
+      value.Set("windowId", browser->GetSessionID().id());
+      value.Set("index", index);
+      value.Set("active", model->GetActiveWebContents() == contents);
+      value.Set("title", base::UTF16ToUTF8(contents->GetTitle()));
+      value.Set("url", contents->GetLastCommittedURL().spec());
+      tabs.Append(std::move(value));
+    }
+  }
+  return tabs;
+}
+
+}  // namespace ai_control

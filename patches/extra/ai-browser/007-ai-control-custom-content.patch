+std::string AiControlOverlayWebView::BuildCustomHtml(
+    std::string_view html,
+    bool handoff_pending) {
+  const std::string isolated_document = base::StrCat({
+      R"HTML(<!doctype html><html><head><meta charset="utf-8">
+<meta http-equiv="Content-Security-Policy" content="default-src 'none';
+img-src data:; style-src 'unsafe-inline'; script-src 'none'; connect-src 'none';
+frame-src 'none'; child-src 'none'; object-src 'none'; media-src 'none';
+worker-src 'none'; manifest-src 'none'; form-action 'none'; base-uri 'none'; sandbox">
+<meta name="referrer" content="no-referrer"><style>
+html,body{width:100%;min-height:100%;margin:0}body{overflow:auto}
+</style></head><body>)HTML",
+      html, R"HTML(</body></html>)HTML"});
+  displayed_child_document_url_ = GURL("about:srcdoc");
+  const std::string action =
+      handoff_pending ? "<span>已请求接管</span>"
+                      : "<a href='about:blank#handoff'>请求接管</a>";
+  return base::StrCat({
+      R"HTML(<!doctype html><html lang="zh-CN"><head><meta charset="utf-8">
+<meta http-equiv="Content-Security-Policy" content="default-src 'none';
+style-src 'unsafe-inline'; frame-src 'self'; script-src 'none'; connect-src 'none';
+object-src 'none'; form-action 'none'; base-uri 'none'">
+<meta name="referrer" content="no-referrer"><style>
+*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0}
+body{display:grid;grid-template-rows:36px minmax(0,1fr);overflow:hidden;
+font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
+letter-spacing:0;background:rgba(8,11,13,.38);color:#f7faf9}
+header{display:flex;align-items:center;justify-content:space-between;gap:16px;
+padding:0 14px;background:#111517;border-bottom:1px solid rgba(255,255,255,.14);
+box-shadow:0 8px 24px rgba(0,0,0,.28);font-size:11px;font-weight:650}
+.label{display:flex;align-items:center;gap:8px}.live{width:7px;height:7px;
+border-radius:50%;background:#cdee4c;box-shadow:0 0 12px rgba(205,238,76,.7)}
+.mode{color:#a9b2af;font:600 10px/1 ui-monospace,SFMono-Regular,Menlo,monospace}
+a,header span{color:#f7faf9;text-decoration:none}iframe{width:100%;height:100%;border:0;
+background:transparent} @media(max-width:520px){.mode{display:none}}
+</style></head><body><header><div class="label"><i class="live"></i>
+<strong>AutoPush 正在使用此页面</strong><span class="mode">CUSTOM OVERLAY</span></div>
+<div>)HTML",
+      action,
+      R"HTML(</div></header><iframe title="AI 自定义状态内容" sandbox
+referrerpolicy="no-referrer" srcdoc=")HTML",
+      Escape(isolated_document),
+      R"HTML("></iframe></body></html>)HTML"});
+}
+
+void AiControlOverlayWebView::ConfigureWebContents() {
+  content::WebContents* contents = GetWebContents();
+  blink::web_pref::WebPreferences preferences =
+      contents->GetOrCreateWebPreferences();
+  preferences.javascript_enabled = false;
+  preferences.cookie_enabled = false;
+  preferences.local_storage_enabled = false;
+  preferences.plugins_enabled = false;
+  preferences.remote_fonts_enabled = false;
+  preferences.hyperlink_auditing_enabled = false;
+  preferences.allow_file_access_from_file_urls = false;
+  preferences.allow_universal_access_from_file_urls = false;
+  preferences.javascript_can_access_clipboard = false;
+  contents->SetWebPreferences(preferences);
+}
+
+void AiControlOverlayWebView::NotifyHumanRequested() {
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce([](int32_t tab_handle) {
+        if (AiControlService* service = AiControlService::Get()) {
+          service->NotifyHumanRequested(tab_handle);
+        }
+      }, displayed_tab_handle_));
+}

+animation:spin 1.8s linear infinite}
+.spinner:before{content:"";position:absolute;inset:4px;border-radius:50%;background:#111517}
+.spinner:after{content:"";position:absolute;inset:16px;border-radius:50%;background:#f7faf9;
+box-shadow:0 0 16px rgba(37,214,194,.65)}
+h1{margin:0;font-size:20px;line-height:1.28;font-weight:650;color:#f7faf9}

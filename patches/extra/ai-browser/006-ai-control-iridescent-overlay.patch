+.progress-head strong{color:#f7faf9;font-size:11px}.track{height:6px;overflow:hidden;
+border-radius:3px;background:#282e2f;box-shadow:inset 0 1px 2px rgba(0,0,0,.5)}
+.bar{position:relative;height:100%;width:)HTML",

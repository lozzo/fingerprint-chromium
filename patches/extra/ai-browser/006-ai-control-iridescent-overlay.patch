+border-radius:8px;background:linear-gradient(105deg,#25d6c2,#cdee4c,#ff805d,#ee528e,
+#8c7cff,#25d6c2);background-size:320% 100%;box-shadow:0 26px 80px rgba(0,0,0,.46),
+0 0 54px rgba(37,214,194,.16);animation:edge-flow 5s linear infinite}
+.panel{position:relative;overflow:hidden;border-radius:7px;padding:26px 28px 22px;

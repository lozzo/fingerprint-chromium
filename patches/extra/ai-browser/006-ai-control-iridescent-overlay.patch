From: AI Browser Control <ai-control@localhost>
Subject: [PATCH] Give the AI control overlay an iridescent activity surface

Replace the neutral loading card with a browser-native automation status
surface. The overlay keeps all presentation inside its isolated WebView while
adding a moving spectrum edge, scan bands, explicit progress, and reduced
motion handling.

---
 chrome/browser/ai_control/ai_control_overlay_web_view.cc | 112 +++++++++++++---
 1 file changed, 81 insertions(+), 31 deletions(-)

diff --git a/chrome/browser/ai_control/ai_control_overlay_web_view.cc b/chrome/browser/ai_control/ai_control_overlay_web_view.cc
--- a/chrome/browser/ai_control/ai_control_overlay_web_view.cc
+++ b/chrome/browser/ai_control/ai_control_overlay_web_view.cc
@@ -101,9 +101,12 @@ void AiControlOverlayWebView::Refresh() {
       web_contents()->WasShown();
     }
   }
-  if (web_contents() && web_contents()->GetRenderWidgetHostView()) {
-    web_contents()->GetRenderWidgetHostView()->SetBackgroundColor(
-        SK_ColorTRANSPARENT);
+  if (web_contents()) {
+    web_contents()->SetPageBaseBackgroundColor(SK_ColorTRANSPARENT);
+    if (web_contents()->GetRenderWidgetHostView()) {
+      web_contents()->GetRenderWidgetHostView()->SetBackgroundColor(
+          SK_ColorTRANSPARENT);
+    }
   }
 }
 
@@ -147,33 +147,80 @@ std::string AiControlOverlayWebView::BuildHtml() const {

+.signal i{display:block;width:18px;height:2px;background:#3b4443}.signal i:nth-child(1){background:#25d6c2}
+.signal i:nth-child(2){background:#cdee4c}.signal i:nth-child(3){background:#ff805d}
+.actions{display:flex;justify-content:flex-end}a,.waiting{font-size:12px;font-weight:650;
+padding:8px 10px;border-radius:4px}a{color:#f7faf9;text-decoration:none;

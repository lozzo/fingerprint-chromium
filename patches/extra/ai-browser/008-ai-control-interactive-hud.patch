+void AiControlOverlayWebView::NotifyAiRequested() {
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce([](int32_t tab_handle) {
+        if (AiControlService* service = AiControlService::Get()) {
+          service->NotifyAiRequested(tab_handle);
+        }
+      }, displayed_tab_handle_));
+}
+
+void AiControlOverlayWebView::UpdateBounds(bool human_owned) {
+  if (!container_) {
+    return;
+  }
+  const gfx::Rect contents_bounds = container_->GetContentsBounds();
+  if (!human_owned) {
+    SetBoundsRect(contents_bounds);
+    return;
+  }
+  const int width = std::min(784, std::max(0, contents_bounds.width() - 24));
+  const int height = std::min(132, std::max(0, contents_bounds.height() - 24));
+  SetBoundsRect(gfx::Rect(
+      contents_bounds.x() + (contents_bounds.width() - width) / 2,
+      contents_bounds.y() + 12, width, height));
+}

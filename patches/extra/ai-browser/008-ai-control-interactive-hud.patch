+void AiControlOverlayWebView::ScheduleOverlayAction(std::string action) {
+  if (action.empty()) {
+    return;
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<AiControlOverlayWebView> overlay,
+             std::string action) {
+            if (overlay) {
+              overlay->HandleOverlayAction(action);
+            }
+          },
+          weak_factory_.GetWeakPtr(), std::move(action)));
+}
+
+bool AiControlOverlayWebView::HandleOverlayAction(std::string_view action) {
+  if (action == "handoff") {
+    NotifyHumanRequested();
+    return true;
+  }
+  if (action == "resume") {
+    NotifyAiRequested();
+    return true;
+  }
+  if (action == "backdrop-dim") {
+    backdrop_mode_ = BackdropMode::kDim;
+    Refresh();
+    return true;
+  }
+  if (action == "backdrop-clear") {
+    backdrop_mode_ = BackdropMode::kClear;
+    Refresh();
+    return true;
+  }
+  return false;
+}

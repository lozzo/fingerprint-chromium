+void AiControlService::NotifyAiRequested(int32_t tab_handle) {
+  auto it = tab_visuals_.find(tab_handle);
+  if (!active_connection_id_.has_value() || it == tab_visuals_.end() ||
+      it->second.ownership != "human") {
+    return;
+  }
+  base::DictValue event;
+  event.Set("eventSeq", static_cast<double>(++event_seq_));
+  event.Set("method", "Control.aiRequested");
+  event.SetByDottedPath(
+      "params.tabId", base::StringPrintf("tab-%d", tab_handle));
+  event.SetByDottedPath("params.ownership", "human");
+  SendMessage(*active_connection_id_, std::move(event));
 }
 

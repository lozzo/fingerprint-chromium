+std::optional<int32_t> ParseTabId(std::string_view tab_id) {
+  constexpr std::string_view kPrefix = "tab-";
+  if (!base::StartsWith(tab_id, kPrefix)) {
+    return std::nullopt;
+  }
+  int value = 0;
+  if (!base::StringToInt(tab_id.substr(kPrefix.size()), &value) || value <= 0) {
+    return std::nullopt;
+  }
+  return value;
+}
+
+std::optional<SkColor> ParseColor(std::string_view text) {
+  if (!text.empty() && text.front() == '#') {
+    text.remove_prefix(1);
+  }
+  if (text.size() != 6 && text.size() != 8) {
+    return std::nullopt;
+  }
+  uint32_t value = 0;
+  if (!base::HexStringToUInt(text, &value)) {
+    return std::nullopt;
+  }
+  return text.size() == 6 ? SkColorSetARGB(0xff, (value >> 16) & 0xff,
+                                           (value >> 8) & 0xff, value & 0xff)
+                          : value;
+}

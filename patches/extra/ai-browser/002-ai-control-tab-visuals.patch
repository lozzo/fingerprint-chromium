+std::optional<SkColor> AiControlService::GetTabColor(int32_t tab_handle) const {
+  auto it = tab_visuals_.find(tab_handle);
+  if (it == tab_visuals_.end() || !it->second.color.has_value()) {
+    return std::nullopt;
+  }
+  SkColor color = *it->second.color;
+  double opacity = 1.0;
+  const double seconds = base::TimeTicks::Now().since_origin().InSecondsF();
+  if (it->second.animation == "pulse") {
+    opacity = 0.62 + 0.38 * ((std::sin(seconds * 5.23598776) + 1.0) / 2.0);
+  } else if (it->second.animation == "loading") {
+    const double phase = std::fmod(seconds, 1.4) / 1.4;
+    opacity = 0.48 + 0.52 * (1.0 - std::abs(phase * 2.0 - 1.0));
+  }
+  return SkColorSetA(color, static_cast<U8CPU>(SkColorGetA(color) * opacity));
+}
+
+void AiControlService::NotifyTabClicked(int32_t tab_handle) {
+  if (!active_connection_id_.has_value()) {
+    return;
+  }
+  base::DictValue event;
+  event.Set("eventSeq", static_cast<double>(++event_seq_));
+  event.Set("method", "Tab.clicked");
+  event.SetByDottedPath("params.tabId",
+                        base::StringPrintf("tab-%d", tab_handle));
+  SendMessage(*active_connection_id_, std::move(event));
+}
+
+bool AiControlService::TabExists(int32_t tab_handle) const {
+  for (BrowserWindowInterface* browser : GetAllBrowserWindowInterfaces()) {
+    TabStripModel* model = browser->GetTabStripModel();
+    for (int index = 0; index < model->count(); ++index) {
+      if (model->GetTabAtIndex(index)->GetHandle().raw_value() == tab_handle) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+void AiControlService::ScheduleTabPaint(int32_t tab_handle) const {
+  for (BrowserWindowInterface* browser : GetAllBrowserWindowInterfaces()) {
+    TabStripModel* model = browser->GetTabStripModel();
+    for (int index = 0; index < model->count(); ++index) {
+      if (model->GetTabAtIndex(index)->GetHandle().raw_value() != tab_handle) {
+        continue;
+      }
+      BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+      if (browser_view && browser->IsTabStripVisible()) {
+        browser_view->horizontal_tab_strip_for_testing()
+            ->tab_at(index)
+            ->SchedulePaint();
+      }
+      return;
+    }
+  }
+}
+
+void AiControlService::UpdateAnimationTimer() {
+  const bool has_animation = std::ranges::any_of(
+      tab_visuals_, [](const auto& entry) {
+        return entry.second.animation != "none";
+      });
+  if (has_animation && !animation_timer_.IsRunning()) {
+    animation_timer_.Start(FROM_HERE, base::Milliseconds(50), this,
+                           &AiControlService::OnAnimationTick);
+  } else if (!has_animation) {
+    animation_timer_.Stop();
+  }
+}
+
+void AiControlService::OnAnimationTick() {
+  for (const auto& [handle, visual] : tab_visuals_) {
+    if (visual.animation != "none") {
+      ScheduleTabPaint(handle);
+    }
+  }
+}

+  METADATA_HEADER(AiControlOverlayWebView, views::WebView)
+
+ public:
+  explicit AiControlOverlayWebView(BrowserWindowInterface* browser);
+  AiControlOverlayWebView(const AiControlOverlayWebView&) = delete;
+  AiControlOverlayWebView& operator=(const AiControlOverlayWebView&) = delete;
+  ~AiControlOverlayWebView() override;
+
+  static void RefreshAll();
+  void ObserveContainer(views::View* container);
+  void Refresh();
+
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;

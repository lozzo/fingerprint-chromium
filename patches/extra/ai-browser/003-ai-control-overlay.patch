+std::optional<AiControlService::OverlayPresentation>
+AiControlService::GetOverlayPresentation(int32_t tab_handle) const {
+  auto it = tab_visuals_.find(tab_handle);
+  if (it == tab_visuals_.end() || !it->second.overlay_visible) {
+    return std::nullopt;
+  }
+  OverlayPresentation presentation;
+  presentation.title = it->second.overlay_title;
+  presentation.message = it->second.overlay_message;
+  presentation.progress = it->second.overlay_progress;
+  presentation.handoff_pending = it->second.handoff_pending;
+  return presentation;

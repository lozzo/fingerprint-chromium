+  std::string BuildHtml() const;
+  void HideOverlay();
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<views::View> container_ = nullptr;
+  int32_t displayed_tab_handle_ = 0;
+  std::string displayed_html_;
+  base::ScopedObservation<views::View, views::ViewObserver>
+      container_observation_{this};
+};
+
+}  // namespace ai_control
+
+#endif  // CHROME_BROWSER_AI_CONTROL_AI_CONTROL_OVERLAY_WEB_VIEW_H_

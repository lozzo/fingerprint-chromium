+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/contents_container_view.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "url/gurl.h"
+
+namespace ai_control {
+namespace {
+
+using OverlaySet = base::flat_set<AiControlOverlayWebView*>;
+
+OverlaySet& GetOverlaySet() {
+  static base::NoDestructor<OverlaySet> overlays;
+  return *overlays;
+}
+
+std::string Escape(std::string_view value) {
+  return base::EscapeForHTML(value);
+}
+
+}  // namespace
+
+AiControlOverlayWebView::AiControlOverlayWebView(
+    BrowserWindowInterface* browser)
+    : browser_(browser) {
+  SetBrowserContext(browser->GetProfile());
+  SetVisible(false);
+  browser_->GetTabStripModel()->AddObserver(this);
+  GetOverlaySet().insert(this);
+}
+
+AiControlOverlayWebView::~AiControlOverlayWebView() {
+  GetOverlaySet().erase(this);
+  browser_->GetTabStripModel()->RemoveObserver(this);
+  SetWebContents(nullptr);
+}
+
+void AiControlOverlayWebView::RefreshAll() {
+  for (AiControlOverlayWebView* overlay : GetOverlaySet()) {
+    overlay->Refresh();
+  }
+}
+
+void AiControlOverlayWebView::ObserveContainer(views::View* container) {
+  container_ = container;
+  container_observation_.Observe(container);
+  SetBoundsRect(container->GetContentsBounds());
+}
+
+void AiControlOverlayWebView::Refresh() {
+  AiControlService* service = AiControlService::Get();
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser_);
+  if (!container_ || !browser_view ||
+      browser_view->GetActiveContentsContainerView() != container_) {
+    HideOverlay();
+    return;
+  }
+  tabs::TabInterface* tab = browser_->GetTabStripModel()->GetActiveTab();
+  if (!service || !tab) {
+    HideOverlay();
+    return;
+  }
+
+  displayed_tab_handle_ = tab->GetHandle().raw_value();
+  if (!service->GetOverlayPresentation(displayed_tab_handle_).has_value()) {
+    HideOverlay();
+    return;
+  }
+
+  std::string html = BuildHtml();
+  if (html != displayed_html_) {
+    displayed_html_ = html;
+    LoadInitialURL(GURL("data:text/html;base64," + base::Base64Encode(html)));
+  }
+  if (!GetVisible()) {
+    SetVisible(true);
+    if (web_contents()) {
+      web_contents()->WasShown();
+    }
+  }
+  if (web_contents() && web_contents()->GetRenderWidgetHostView()) {
+    web_contents()->GetRenderWidgetHostView()->SetBackgroundColor(
+        SK_ColorTRANSPARENT);
+  }
+}
+
+void AiControlOverlayWebView::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  Refresh();
+}
+
+void AiControlOverlayWebView::DidStartNavigation(
+    content::NavigationHandle* navigation_handle) {
+  if (navigation_handle->GetURL().ref() != "handoff") {
+    return;
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce([](int32_t tab_handle) {
+        if (AiControlService* service = AiControlService::Get()) {
+          service->NotifyHumanRequested(tab_handle);
+        }
+      }, displayed_tab_handle_));
+}
+
+void AiControlOverlayWebView::OnViewBoundsChanged(views::View* observed_view) {
+  SetBoundsRect(observed_view->GetContentsBounds());
+}
+
+std::string AiControlOverlayWebView::BuildHtml() const {
+  const auto presentation =
+      AiControlService::Get()->GetOverlayPresentation(displayed_tab_handle_);
+  if (!presentation.has_value()) {
+    return std::string();
+  }
+  const std::string progress = presentation->progress.has_value()
+                                   ? base::NumberToString(
+                                         std::clamp(*presentation->progress, 0,
+                                                    100))
+                                   : "38";
+  const std::string action = presentation->handoff_pending
+                                 ? "<span class='waiting'>已请求接管</span>"
+                                 : "<a href='about:blank#handoff'>请求接管</a>";
+  return base::StrCat({
+      "<!doctype html><html lang='zh-CN'><head><meta charset='utf-8'>",
+      "<meta name='color-scheme' content='light dark'><style>",
+      "*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0}",
+      "body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;",
+      "letter-spacing:0;background:rgba(18,20,24,.46);color:#202124;display:grid;",
+      "place-items:center;backdrop-filter:blur(3px)}main{width:min(420px,calc(100% - 32px));",
+      "background:#fff;border:1px solid rgba(32,33,36,.18);border-radius:8px;",
+      "box-shadow:0 12px 36px rgba(0,0,0,.22);padding:22px 24px}",
+      ".top{display:flex;align-items:center;gap:14px}.spinner{width:28px;height:28px;",
+      "border:3px solid #d7dbe0;border-top-color:#0b57d0;border-radius:50%;",
+      "animation:spin 1s linear infinite;flex:none}h1{font-size:17px;line-height:1.35;",
+      "margin:0;font-weight:600}p{font-size:13px;line-height:1.55;color:#5f6368;",
+      "margin:12px 0 16px}.track{height:4px;background:#e7e9ec;border-radius:2px;",
+      "overflow:hidden}.bar{height:100%;width:", progress,
+      "%;background:#0b57d0;transition:width .2s ease}.actions{display:flex;",
+      "justify-content:flex-end;margin-top:18px}a{color:#0b57d0;text-decoration:none;",
+      "font-size:13px;font-weight:600;padding:8px 10px;border-radius:4px}",
+      "a:hover{background:#eef3fd}.waiting{font-size:13px;color:#5f6368;padding:8px 10px}",
+      "@keyframes spin{to{transform:rotate(360deg)}}",
+      "@media(prefers-reduced-motion:reduce){.spinner{animation:none}.bar{transition:none}}",
+      "@media(prefers-color-scheme:dark){body{color:#e8eaed;background:rgba(0,0,0,.58)}",
+      "main{background:#202124;border-color:#4a4d51}p,.waiting{color:#bdc1c6}",
+      ".track{background:#3c4043}a{color:#8ab4f8}a:hover{background:#303845}}",
+      "</style></head><body><main><div class='top'><div class='spinner'></div><h1>",
+      Escape(presentation->title), "</h1></div><p>",
+      Escape(presentation->message), "</p><div class='track'><div class='bar'></div>",
+      "</div><div class='actions'>", action,
+      "</div></main></body></html>"});
+}
+
+void AiControlOverlayWebView::HideOverlay() {
+  displayed_tab_handle_ = 0;
+  displayed_html_.clear();
+  if (GetVisible()) {
+    SetVisible(false);
+    if (web_contents()) {
+      web_contents()->WasHidden();
+    }
+  }
+}
+
+BEGIN_METADATA(AiControlOverlayWebView)
+END_METADATA
+
+}  // namespace ai_control

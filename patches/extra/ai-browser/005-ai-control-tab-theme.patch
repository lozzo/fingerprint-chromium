+CustomThemeSupplier* AiControlService::GetActiveWindowTheme(
+    BrowserWindowInterface* browser) const {
+  if (!browser) {
+    return nullptr;
+  }
+  tabs::TabInterface* active_tab = browser->GetTabStripModel()->GetActiveTab();
+  if (!active_tab) {
+    return nullptr;
+  }
+  auto it = tab_visuals_.find(active_tab->GetHandle().raw_value());
+  return it == tab_visuals_.end() ? nullptr : it->second.theme_pack.get();
+}
+
+void AiControlService::RefreshWindowTheme(
+    BrowserWindowInterface* browser) const {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (browser_view && browser_view->GetWidget()) {
+    browser_view->GetWidget()->ThemeChanged();
+  }
+}

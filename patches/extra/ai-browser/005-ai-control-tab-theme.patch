 #include "ui/gfx/favicon_size.h"
@@ -48,4 +49,29 @@
 #include "ui/views/widget/widget.h"
 
 namespace {
+
+std::optional<SkColor> GetAiTabColor(const Tab* tab) {
+  if (auto* service = ai_control::AiControlService::Get()) {
+    return service->GetTabColor(tab->tab_handle().raw_value());
+  }
+  return std::nullopt;
+}
+
+SkColor GetAiTabBackgroundColor(
+    SkColor color,
+    TabStyle::TabSelectionState selection_state,
+    double hover_animation_value) {
+  const SkAlpha alpha = SkColorGetA(color);
+  SkColor result = SkColorSetA(color, SK_AlphaOPAQUE);
+  const SkColor contrast = color_utils::GetColorWithMaxContrast(result);
+  if (selection_state == TabStyle::TabSelectionState::kSelected) {
+    result = color_utils::AlphaBlend(contrast, result, 0.10f);
+  }
+  if (hover_animation_value > 0.0) {
+    result = color_utils::AlphaBlend(
+        contrast, result, 0.14f * static_cast<float>(hover_animation_value));
+  }
+  return SkColorSetA(result, alpha);
+}
+

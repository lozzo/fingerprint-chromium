   } else if (*method == "Overlay.show" || *method == "Overlay.update" ||
@@ -583,9 +583,9 @@ base::DictValue AiControlService::HandleCommand(
       state.color = SkColorSetRGB(0x0b, 0x57, 0xd0);
       state.animation = "loading";
     }
     ++state.state_version;
     result.Set("stateVersion", static_cast<double>(state.state_version));
     result.Set("ownership", state.ownership);
-    ScheduleTabPaint(*handle);
+    RefreshTabTheme(*handle);
     UpdateAnimationTimer();
     RefreshOverlays();
@@ -777,5 +777,24 @@ void AiControlService::ScheduleTabPaint(int32_t tab_handle) const {
   }
 }
 
+void AiControlService::RefreshTabTheme(int32_t tab_handle) const {
+  for (BrowserWindowInterface* browser : GetAllBrowserWindowInterfaces()) {
+    TabStripModel* model = browser->GetTabStripModel();
+    for (int index = 0; index < model->count(); ++index) {
+      if (model->GetTabAtIndex(index)->GetHandle().raw_value() != tab_handle) {
+        continue;
+      }
+      BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+      if (browser_view && browser->IsTabStripVisible()) {
+        Tab* tab =
+            browser_view->horizontal_tab_strip_for_testing()->tab_at(index);
+        tab->OnThemeChanged();
+        tab->SchedulePaint();
+      }
+      return;
+    }
+  }
+}
